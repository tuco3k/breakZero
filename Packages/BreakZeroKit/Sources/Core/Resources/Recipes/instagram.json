{
  "platform": "instagram",
  "version": 5,
  "minEngine": 1,
  "hosts": ["instagram.com", "www.instagram.com", "m.instagram.com"],
  "authHosts": ["accounts.instagram.com", "www.facebook.com", "m.facebook.com", "accountscenter.instagram.com"],
  "session": {"cookies": ["sessionid"]},
  "shortFormRoutes": ["^/reels?(/|$)", "^/[A-Za-z0-9._]+/reels/?$"],
  "landing": {
    "default": "inbox",
    "options": {"inbox": "/direct/inbox/", "following": "/?variant=following"}
  },
  "toggles": [
    {"id": "ig.blockReels", "defaultOn": true},
    {"id": "ig.blockExplore", "defaultOn": true},
    {"id": "ig.blockShop", "defaultOn": true},
    {"id": "ig.hideReelsEntryPoints", "defaultOn": true},
    {"id": "ig.hideSuggested", "defaultOn": true},
    {"id": "ig.hideSponsored", "defaultOn": true},
    {"id": "ig.hideFeed", "defaultOn": false},
    {"id": "ig.friendsOnly", "defaultOn": true},
    {"id": "ig.forceFollowing", "defaultOn": true}
  ],
  "scopes": {
    "fromThread": "^/direct/t/"
  },
  "routes": [
    {"id": "ig.route.reelsFeed", "toggle": "ig.blockReels", "shortForm": true, "pattern": "^/reels/?$", "action": "redirect", "to": "{landing}"},
    {"id": "ig.route.reelsAudio", "toggle": "ig.blockReels", "shortForm": true, "pattern": "^/reels/audio/", "action": "block"},
    {"id": "ig.route.reelOnce", "toggle": "ig.blockReels", "shortForm": true, "pattern": "^/reels?/(?<id>[A-Za-z0-9_-]+)/?$", "action": "allowOnce", "scope": "fromThread", "key": "id"},
    {"id": "ig.route.profileReels", "toggle": "ig.blockReels", "shortForm": true, "pattern": "^/(?<user>[A-Za-z0-9._]+)/reels/?$", "action": "redirect", "to": "/{user}/"},
    {"id": "ig.route.exploreSearch", "toggle": "ig.blockExplore", "pattern": "^/explore/search(/|$)", "action": "allow"},
    {"id": "ig.route.explore", "toggle": "ig.blockExplore", "pattern": "^/explore(/|$)", "action": "block"},
    {"id": "ig.route.shop", "toggle": "ig.blockShop", "pattern": "^/shop(/|$)", "action": "block"}
  ],
  "hide": [
    {"id": "ig.hide.reelsTab", "toggle": "ig.hideReelsEntryPoints", "shortForm": true, "selector": "a[href=\"/reels/\"]"},
    {"id": "ig.hide.exploreTab", "toggle": "ig.blockExplore", "selector": "a[href=\"/explore/\"]"},
    {"id": "ig.hide.profileReelsTab", "toggle": "ig.hideReelsEntryPoints", "shortForm": true, "selector": "a[href$=\"/reels/\"]"},
    {"id": "ig.hide.sponsored", "toggle": "ig.hideSponsored", "selector": "article:has(a[href*=\"/ads/\"])", "routes": ["^/$"]},
    {"id": "ig.hide.feed", "toggle": "ig.hideFeed", "selector": "main article", "routes": ["^/$"]}
  ],
  "heuristics": [
    {"id": "ig.heur.reelLinks", "toggle": "ig.hideReelsEntryPoints", "shortForm": true, "type": "anchorHref", "pattern": "^/reels?/", "hideAncestor": 0},
    {"id": "ig.heur.profileReelsTab", "toggle": "ig.hideReelsEntryPoints", "shortForm": true, "type": "anchorHref", "pattern": "^/[A-Za-z0-9._]+/reels/?$", "hideAncestor": 0},
    {"id": "ig.heur.suggestedPeople", "toggle": "ig.hideSuggested", "type": "anchorHref", "pattern": "^/explore/people/", "hideAncestor": 3, "routes": ["^/$"]},
    {"id": "ig.heur.exploreLinks", "toggle": "ig.blockExplore", "type": "anchorHref", "pattern": "^/explore/?$", "hideAncestor": 0}
  ],
  "search": {
    "toggle": "ig.blockExplore",
    "entryRules": ["ig.hide.exploreTab", "ig.heur.exploreLinks"],
    "rootPattern": "^/explore/?$",
    "searchPath": "/explore/search/",
    "routes": ["^/explore/search(/|$)"],
    "gridLink": "^/(p|reels?|tv)/[A-Za-z0-9_-]+",
    "gridAncestor": 1
  },
  "friendsFilter": {
    "toggle": "ig.friendsOnly",
    "forceFollowingToggle": "ig.forceFollowing",
    "forcedToggles": ["ig.hideSuggested", "ig.hideSponsored"],
    "feedRoutes": ["^/$"],
    "feedPath": "/",
    "followingQuery": "variant=following",
    "post": "main article, main [role=\"article\"]",
    "profileLink": "^/(?<user>[A-Za-z0-9._]{1,30})/?$",
    "reservedPaths": ["about", "accounts", "ajax", "api", "ar", "challenge", "create", "data", "developer", "direct", "emails", "explore", "graphql", "help", "jobs", "legal", "lite", "locations", "nametag", "notifications", "oauth", "p", "press", "privacy", "qr", "reel", "reels", "session", "settings", "shop", "static", "stories", "tags", "threads", "topics", "tv", "web", "your_activity"],
    "postLink": "^/(p|reels?|tv)/[A-Za-z0-9_-]+",
    "storyTray": "a[href^=\"/stories/\"]",
    "storyRoute": "^/stories/(?<user>[A-Za-z0-9._]+)(/|$)",
    "storyExempt": ["highlights"],
    "storyAuthor": "section header a[href]",
    "caughtUpAfter": 20,
    "findingAfter": 5,
    "idleSeconds": 4,
    "scanRoutes": {
      "followers": "^/(?<owner>[A-Za-z0-9._]+)/followers/?$",
      "following": "^/(?<owner>[A-Za-z0-9._]+)/following/?$",
      "closeFriends": "^/accounts/close_friends/?$"
    },
    "scanChecked": "input[type=checkbox]:checked, [role=checkbox][aria-checked=true]"
  },
  "allowZones": [
    "^/direct/",
    "^/accounts/",
    "^/challenge/",
    "^/two_factor",
    "^/create/",
    "^/emails/",
    "^/session/",
    "^/oauth/",
    "^/privacy/checks/",
    "^/legal/"
  ],
  "canaries": [
    {"id": "ig.canary.reelsTab", "toggle": "ig.hideReelsEntryPoints", "shortForm": true, "route": "^/", "mustNotExist": {"anchorHref": "^/reels/?$"}},
    {"id": "ig.canary.reelLinksHome", "toggle": "ig.hideReelsEntryPoints", "shortForm": true, "route": "^/$", "mustNotExist": {"anchorHref": "^/reels?/[A-Za-z0-9_-]+"}}
  ]
}
